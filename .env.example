# Environment Settings
PROJECT_NAME="Adaptive AI Cyber Deception Framework"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Database: SQLite by default for zero-friction local execution,
# or override with: postgresql+asyncpg://postgres:postgres@localhost:5432/cyber_deception
DATABASE_URL="sqlite+aiosqlite:///./cyber_deception.db"
DB_ECHO=False

# Zero Trust Defaults
ZT_WEIGHT_IDENTITY=0.20
ZT_WEIGHT_DEVICE=0.15
ZT_WEIGHT_BEHAVIOUR=0.35
ZT_WEIGHT_CONTEXT=0.15
ZT_WEIGHT_NETWORK=0.15

ZT_THRESHOLD_ALLOW=0.20
ZT_THRESHOLD_VERIFY=0.40
ZT_THRESHOLD_RESTRICT=0.60
ZT_THRESHOLD_DECEIVE=0.80

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
